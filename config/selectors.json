      },
      "form": {
        "name": [
          { "type": "role", "role": "textbox", "name": "名前" },
          { "type": "label", "text": "名前" },
          { "type": "css", "selector": "input[name=\"name\"]" }
        ],
        "email": [
          { "type": "role", "role": "textbox", "name": "メール" },
          { "type": "label", "text": "メール" },
          { "type": "css", "selector": "input[name=\"email\"]" }
