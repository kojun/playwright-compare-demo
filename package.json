{
  "name": "playwright-compare-demo",
  "version": "1.0.0",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "playwright test --reporter=html",
    "test:dsl": "playwright test dsl-test-runner.spec.ts --reporter=line",
    "test:current": "TEST_TARGET=current COMPARISON_MODE=single playwright test dsl-test-runner.spec.ts --reporter=line",
    "test:new": "TEST_TARGET=new COMPARISON_MODE=single playwright test dsl-test-runner.spec.ts --reporter=line",
    "test:compare": "COMPARISON_MODE=comparison playwright test dsl-test-runner.spec.ts --reporter=line",
    "test:scenario": "SCENARIO=${SCENARIO:-scenario1} COMPARISON_MODE=comparison playwright test dsl-test-runner.spec.ts --reporter=line",
    "scenarios:list": "ls config/scenarios/*.yaml | xargs -I {} basename {} .yaml",
    "report": "playwright show-report"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kojun/playwright-compare-demo.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "pg": "^8.16.3"
  },
  "dependencies": {
    "@types/js-yaml": "^4.0.9",
    "js-yaml": "^4.1.0"
  }
}
