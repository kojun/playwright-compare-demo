<table>
  <thead><tr><th>ID</th><th>Name</th><th>Email</th><th>操作</th></tr></thead>
  <tbody>
    <% rows.forEach(r => { %>
      <tr>
        <td><%= r.id %></td>
        <td><%= r.name %></td>
        <td><%= r.email %></td>
        <td>
          <a href="/customers/<%= r.id %>/edit">編集</a>
          <form class="inline" method="post" action="/customers/<%= r.id %>/delete" onsubmit="return confirmDelete('<%= r.name %>')">
            <button type="submit">削除</button>
          </form>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>

<script>
function confirmDelete(customerName) {
  return confirm('顧客「' + customerName + '」を削除してもよろしいですか？\nこの操作は元に戻せません。');
}
</script>