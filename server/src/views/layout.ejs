<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= appName %> - 現新比較デモ</title>
  <style>
    body { font-family: system-ui, sans-serif; margin: 2rem; }
    header { margin-bottom: 1rem; }
    table { border-collapse: collapse; width: 100%; }
    th, td { border: 1px solid #ccc; padding: .5rem; }
    form.inline { display: inline; }
  </style>
</head>
<body>
<header>
  <div style="display: flex; justify-content: space-between; align-items: center;">
    <div>
      <h1><%= appName %> / Customers</h1>
      <% if (typeof username !== 'undefined') { %>
        <nav>
          <a href="/customers">一覧</a> | <a href="/customers/new">新規</a>
        </nav>
      <% } %>
    </div>
    <% if (typeof username !== 'undefined') { %>
      <div style="text-align: right;">
        <span>ログイン中: <%= username %></span><br>
        <form method="post" action="/logout" style="display: inline;">
          <button type="submit" style="margin-top: 0.5rem; padding: 0.25rem 0.5rem; font-size: 0.9em;">ログアウト</button>
        </form>
      </div>
    <% } %>
  </div>
</header>
<%- include('flash') %>
<main>
  <%- body %>
</main>
</body>
</html>